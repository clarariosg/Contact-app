package main

import "strconv"

templ layout(content templ.Component) {
	<!DOCTYPE html>
	<html lang="">
		<head>
			<title>Contact App</title>
			<script src="/js/htmx.js"></script>
			<link rel="stylesheet" href="https://unpkg.com/missing.css@1.2.0"/>
		</head>
		<body hx-boost="true">
			<main>
				<header>
					<h1>
						Contact App
					</h1>
				</header>
				@content
			</main>
		</body>
	</html>
}

templ contacts(list []Contact, search string, page int) {
	<form action="/contacts" method="get" class="tool-bar">
		<label for="search">Search </label>
		<input
			id="search"
			type="search"
			name="q"
			value={ search }
			hx-get="/contacts"
			hx-trigger="search, keyup delay:200ms changed"
			hx-target="tbody"
			hx-push-url="true"
			hx-indicator="#spinner"
		/>
		<img
			id="spinner"
			class="htmx-indicator"
			src="/img/spinning-circles.svg"
			alt="Request In Flight..."
		/>
		<input type="submit" value="Search"/>
	</form>
	<table>
		<thead>
			<tr>
				<th>First </th>
				<th>Last </th>
				<th>Phone </th>
				<th>Email </th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@rows(list)
		</tbody>
	</table>
	<div>
		<span style="float: left;">
			if page > 1 {
				<a href={ "/contacts?page=" + strconv.Itoa(page-1) }>Previous</a>
			}
			if len(list) == 10 {
				<a href={ "/contacts?page=" + strconv.Itoa(page+1) }>Next</a>
			}
		</span>
	</div>
	<p>
		<a href="/contacts/new">Add Contact</a>
	</p>
}

templ rows(list []Contact) {
	for _, c := range list {
		<tr>
			<td>{ c.First }</td>
			<td>{ c.Last }</td>
			<td>{ c.Phone }</td>
			<td>{ c.Email }</td>
			<td>
				<a href={ "/contacts/" + strconv.Itoa(c.ID) + "/edit" }>Edit</a>
				<a href={ "/contacts/" + strconv.Itoa(c.ID) + "/view" }>View</a>
			</td>
		</tr>
	}
}

templ new(contact Contact) {
	<form action="/contacts/new" method="post">
		<fieldset>
			<legend>Contact Values</legend>
			<p>
				<label for="email">Email</label>
				<input
					name="email"
					id="email"
					type="email"
					placeholder="Email"
					value={ contact.Email }
				/>
			</p>
			<p>
				<label for="first_name">First Name</label>
				<input
					name="first_name"
					id="first_name"
					type="text"
					placeholder="First Name"
					value={ contact.First }
				/>
			</p>
			<p>
				<label for="last_name">Last Name</label>
				<input
					name="last_name"
					id="last_name"
					type="text"
					placeholder="Last Name"
					value={ contact.Last }
				/>
			</p>
			<p>
				<label for="phone">Phone</label>
				<input
					name="phone"
					id="phone"
					type="text"
					placeholder="Phone"
					value={ contact.Phone }
				/>
			</p>
			<button>Save</button>
		</fieldset>
	</form>
	<p>
		<a href="/contacts">Back</a>
	</p>
}

templ view(contact Contact) {
	<h1>{ contact.First } { contact.Last }</h1>
	<div>
		<div>Phone: { contact.Phone }</div>
		<div>Email: { contact.Email }</div>
	</div>
	<p>
		<a href={ "/contacts/" + strconv.Itoa(contact.ID) + "/edit" }>Edit</a>
		<a href="/contacts">Back</a>
	</p>
}

templ edit(contact Contact) {
	<form action={ "/contacts/" + strconv.Itoa(contact.ID) + "/edit" } method="post">
		<fieldset>
			<legend>Contact Values</legend>
			<p>
				<label for="email">Email</label>
				<input
					name="email"
					id="email"
					type="email"
					hx-get={ "/contacts/" + strconv.Itoa(contact.ID) + "/email" }
					hx-target="next .error"
					hx-trigger="change, keyup delay:200ms changed"
					placeholder="Email"
					value={ contact.Email }
				/>
				<span class="error"></span>
			</p>
			<p>
				<label for="first_name">First Name</label>
				<input
					name="first_name"
					id="first_name"
					type="text"
					placeholder="First Name"
					value={ contact.First }
				/>
			</p>
			<p>
				<label for="last_name">Last Name</label>
				<input
					name="last_name"
					id="last_name"
					type="text"
					placeholder="Last Name"
					value={ contact.Last }
				/>
			</p>
			<p>
				<label for="phone">Phone</label>
				<input
					name="phone"
					id="phone"
					type="text"
					placeholder="Phone"
					value={ contact.Phone }
				/>
			</p>
			<button>Save</button>
		</fieldset>
	</form>
	<button
		hx-delete={ "/contacts/" + strconv.Itoa(contact.ID) }
		hx-target="body"
		hx-push-url="true"
		hx-confirm="Are you sure you want to delete this contact?"
	>
		Delete Contact
	</button>
	<p>
		<a href="/contacts">Back</a>
	</p>
}
