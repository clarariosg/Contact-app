package main

import "strconv"
import "contact-app/archiver"
import "fmt"

templ layout(content templ.Component) {
	<!DOCTYPE html>
	<html lang="">
		<head>
			<title>Contact App</title>
			<script src="/js/htmx.js"></script>
			<link rel="stylesheet" href="https://unpkg.com/missing.css@1.2.0"/>
			<link rel="stylesheet" href="/style.css"/>
			<script src="https://unpkg.com/hyperscript.org@0.9.14"></script>
			<script src="/js/rsjs.js"></script>
			<script src="https://unpkg.com/alpinejs"></script>
			<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
			<script src="/js/sweetconfirm.js"></script>
		</head>
		<body hx-boost="true">
			<main>
				<header>
					<h1>
						Contact App
					</h1>
				</header>
				@content
			</main>
		</body>
	</html>
}

templ contacts(list []Contact, search string, page int, archiver *archiver.Archiver) {
	@archive_ui(archiver)
	// formulario de busqueda
	<form action="/contacts" method="get" class="tool-bar">
		// Descripcion del input
		<label for="search">Search </label>
		// Input de texto para buscar contactos
		<input
			id="search"
			type="search"
			name="q"
			value={ search }
			hx-get="/contacts"
			hx-trigger="search, keyup delay:200ms changed"
			hx-target="tbody"
			hx-push-url="true"
			hx-indicator="#spinner"
			_="on keydown[altKey and code is 'KeyS'] from the window
					focus() me"
		/>
		// spinner circular de carga
		<img
			id="spinner"
			class="htmx-indicator"
			src="/img/spinning-circles.svg"
			alt="Request In Flight..."
		/>
		<input type="submit" value="Search"/>
	</form>
	// Tabla de contactos (resultados de busqueda)
	<form x-data="{ selected: []}">
		<template x-if="selected.length > 0">
			<div class="box info tool-bar">
				<slot x-text="selected.length"></slot>
				contacts selected
				<button
					type="button"
					class="bad bg color border"
					hx-delete="/contacts"
					hx-target="body"
					hx-trigger="confirmed"
					@click="sweetConfirm($el, { 
						title: 'Delete these contacts?', 
						showCancelButton: true,
						confirmButtonText: 'Delete'
					})"
				>Delete</button>
				<hr aria-orientation="vertical"/>
				<button type="button" @click="selected = []">Cancel</button>
			</div>
		</template>
		<table>
			<thead>
				<tr>
					<th></th>
					<th>First </th>
					<th>Last </th>
					<th>Phone </th>
					<th>Email </th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@rows(list)
			</tbody>
		</table>
		<button
			hx-delete="/contacts"
			hx-confirm="Are you sure you want to delete these contacts?"
			hx-target="body"
		>
			Delete Selected Contacs
		</button>
	</form>
	// Enlaces previous y next para paginación
	<div>
		<span style="float: left;">
			if page > 1 {
				<a href={ "/contacts?page=" + strconv.Itoa(page-1) }>Previous</a>
			}
			if len(list) == 10 {
				<a href={ "/contacts?page=" + strconv.Itoa(page+1) }>Next</a>
			}
		</span>
	</div>
	<p>
		<a href="/contacts/new">Add Contact</a>
		<span hx-get="/contacts/count" hx-trigger="revealed">
			<img
				id="spinner"
				class="htmx-indicator"
				src="/img/spinning-circles.svg"
			/>
		</span>
	</p>
}

templ rows(list []Contact) {
	for _, c := range list {
		// fila por cada contacto de la lista
		<tr>
			<td>
				// input de selección para eliminar 
				<input
					type="checkbox"
					name="selected_contact_ids"
					value={ c.ID }
					x-model="selected"
				/>
			</td>
			<td>{ c.First }</td>
			<td>{ c.Last }</td>
			<td>{ c.Phone }</td>
			<td>{ c.Email }</td>
			<td>
				<div data-overflow-menu>
					<button
						type="button"
						aria-haspopup="menu"
						aria-controls={ "contact-menu-" + strconv.Itoa(c.ID) }
					>
						Options
					</button>
					<div role="menu" hidden id={ "contact-menu-" + strconv.Itoa(c.ID) }>
						<a role="menuitem" href={ "/contacts/" + strconv.Itoa(c.ID) + "/edit" }>Edit</a>
						<a role="menuitem" href={ "/contacts/" + strconv.Itoa(c.ID) + "/view" }>View</a>
						<a
							role="menuitem"
							href="#"
							hx-delete={ "/contacts/" + strconv.Itoa(c.ID) }
							hx-swap="outerHTML swap:1s"
							hx-confirm="Are you sure you want to delete this contact?"
							hx-target="closest tr"
						>Delete</a>
					</div>
				</div>
			</td>
		</tr>
	}
}

templ new(contact Contact) {
	// formulario para crear un nuevo contacto
	<form action="/contacts/new" method="post">
		<fieldset>
			<legend>Contact Values</legend>
			<p>
				<label for="email">Email</label>
				<input
					name="email"
					id="email"
					type="email"
					placeholder="Email"
					value={ contact.Email }
				/>
			</p>
			<p>
				<label for="first_name">First Name</label>
				<input
					name="first_name"
					id="first_name"
					type="text"
					placeholder="First Name"
					value={ contact.First }
				/>
			</p>
			<p>
				<label for="last_name">Last Name</label>
				<input
					name="last_name"
					id="last_name"
					type="text"
					placeholder="Last Name"
					value={ contact.Last }
				/>
			</p>
			<p>
				<label for="phone">Phone</label>
				<input
					name="phone"
					id="phone"
					type="text"
					placeholder="Phone"
					value={ contact.Phone }
				/>
			</p>
			<button>Save</button>
		</fieldset>
	</form>
	<p>
		<a href="/contacts">Back</a>
	</p>
}

templ view(contact Contact) {
	<h1>{ contact.First } { contact.Last }</h1>
	<div>
		<div>Phone: { contact.Phone }</div>
		<div>Email: { contact.Email }</div>
	</div>
	<p>
		<a href={ "/contacts/" + strconv.Itoa(contact.ID) + "/edit" }>Edit</a>
		<a href="/contacts">Back</a>
	</p>
}

templ edit(contact Contact) {
	// formulario de editar contacto
	<form action={ "/contacts/" + strconv.Itoa(contact.ID) + "/edit" } method="post">
		<fieldset>
			<legend>Contact Values</legend>
			<p>
				<label for="email">Email</label>
				<input
					name="email"
					id="email"
					type="email"
					hx-get={ "/contacts/" + strconv.Itoa(contact.ID) + "/email" }
					hx-target="next .error"
					hx-trigger="change, keyup delay:200ms changed"
					placeholder="Email"
					value={ contact.Email }
				/>
				<span class="error"></span>
			</p>
			<p>
				<label for="first_name">First Name</label>
				<input
					name="first_name"
					id="first_name"
					type="text"
					placeholder="First Name"
					value={ contact.First }
				/>
			</p>
			<p>
				<label for="last_name">Last Name</label>
				<input
					name="last_name"
					id="last_name"
					type="text"
					placeholder="Last Name"
					value={ contact.Last }
				/>
			</p>
			<p>
				<label for="phone">Phone</label>
				<input
					name="phone"
					id="phone"
					type="text"
					placeholder="Phone"
					value={ contact.Phone }
				/>
			</p>
			<button>Save</button>
		</fieldset>
	</form>
	<button
		id="delete-btn"
		hx-delete={ "/contacts/" + strconv.Itoa(contact.ID) }
		hx-target="body"
		hx-push-url="true"
		hx-confirm="Are you sure you want to delete this contact?"
	>
		Delete Contact
	</button>
	<p>
		<a href="/contacts">Back</a>
	</p>
}

templ archive_ui(archiver *archiver.Archiver) {
	<div
		id="archive-ui"
		hx-target="this"
		hx-swap="outerHTML"
	>
		if archiver.Status() == "waiting" {
			<button hx-post="/contacts/archive">
				Download Contact Archive
			</button>
		} else if archiver.Status() == "running" {
			<div hx-get="/contacts/archive" hx-trigger="load delay:500ms">
				Creating Archive...
				<div class="progress">
					<div
						id="archive-progress"
						class="progress-bar"
						role="progressbar"
						aria-valuenow={ archiver.Progress() * 100 }
						style={ fmt.Sprintf("width:%d%%", int(archiver.Progress()*100)) }
					></div>
				</div>
			</div>
		} else if archiver.Status() == "complete" {
			<a
				hx-boost="false"
				href="/contacts/archive/file"
				_="on load click() me"
			>
				Archive Downloading! Click here if the download does not start.
			</a>
			<button hx-delete="/contacts/archive">Clear Download</button>
		}
	</div>
}
